{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qE '\"file_path\" *: *\"[^\"]*\\.rs\"' && cargo fmt --all 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "cargo fmt"
          }
        ]
      }
    ]
  }
}
